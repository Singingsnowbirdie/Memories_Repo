  image: {fileID: 2800000, guid: 2ef8893879a8d6d498961672cfd6be29, type: 3}
  text: "\u0411\u0435\u043D \u2014 \u0442\u044B \u043C\u043E\u0439 \u0431\u0440\u0430\u0442\u0430\u043D!
    \u0422\u043E\u043B\u044C\u043A\u043E \u044D\u0442\u043E \u043D\u0435 \u0441\u0440\u0430\u0431\u043E\u0442\u0430\u0435\u0442.
    \u041F\u0430\u043F\u0430\u0448\u0430 \u0441\u043A\u0430\u0436\u0435\u0442, \u0447\u0442\u043E
    \u0442\u0432\u043E\u044E \u0434\u043E\u043B\u044E \u0442\u0435\u0431\u0435 \u043E\u0442\u0432\u0435\u0441\u0438\u0442
    \u0442\u0432\u043E\u0439 \u043E\u0442\u0435\u0446. \u0410 \u043C\u043D\u0435
    \u0432\u0441\u044B\u043F\u043B\u0435\u0442 \u0441\u0442\u043E\u043B\u044C\u043A\u043E,
    \u0441\u043A\u043E\u043B\u044C\u043A\u043E \u0437\u0430\u0434\u0443\u043C\u0430\u043B."
  transition: 1
  transitionDuration: 0.5
  displayDuration: 12
