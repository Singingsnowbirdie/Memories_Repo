  image: {fileID: 2800000, guid: 3714a36cb4c8e4848929bd56bdfade5a, type: 3}
  text: "\u0421\u0430\u043C\u043E-\u0441\u043E\u0431\u043E\u0439! \u0414\u043E\u0436\u0434\u0435\u043C\u0441\u044F,
    \u0438 \u0441\u043F\u0440\u043E\u0441\u0438\u043C \u0443 \u0442\u0432\u043E\u0435\u0433\u043E
    \u043E\u0442\u0446\u0430, \u0441\u043A\u043E\u043B\u044C\u043A\u043E \u043E\u043D
    \u0445\u043E\u0447\u0435\u0442 \u0442\u0435\u0431\u0435 \u0432\u0441\u044B\u043F\u0430\u0442\u044C.
    \u041F\u043E\u0442\u043E\u043C \u0441\u043A\u0430\u0436\u0435\u043C, \u0447\u0442\u043E
    \u0438\u0433\u0440\u0430\u043B\u0438 \u0432\u043C\u0435\u0441\u0442\u0435. \u0417\u043D\u0430\u0447\u0438\u0442
    \u0442\u0432\u043E\u044F \u2014 \u0442\u043E\u043B\u044C\u043A\u043E \u043F\u043E\u043B\u043E\u0432\u0438\u043D\u0430.
    \u0410 \u0432\u0442\u043E\u0440\u0430\u044F \u043F\u043E\u043B\u043E\u0432\u0438\u043D\u0430
    \u2014 \u043C\u043E\u044F."
