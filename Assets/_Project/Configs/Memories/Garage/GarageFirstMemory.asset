  image: {fileID: 2800000, guid: 5057e888e0414bb5b7808372ef142b8f, type: 3}
  text: "\u0412\u0447\u0435\u0440\u0430 \u0442\u044B \u0437\u0430\u043A\u0440\u044B\u043B
