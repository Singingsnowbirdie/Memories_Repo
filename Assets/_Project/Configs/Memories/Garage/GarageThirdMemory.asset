  image: {fileID: 2800000, guid: 4fb3584bb13e24b4c98ab56259f9e9c9, type: 3}
  text: "\u041C\u0443\u0436\u0447\u0438\u043D\u0430 \u2014 \u0442\u043E\u0442, \u043A\u0442\u043E
    \u043E\u0442\u0432\u0435\u0447\u0430\u0435\u0442 \u0437\u0430 \u0441\u0432\u043E\u0438
    \u0434\u0435\u043B\u0430. \u0418 \u0437\u0430 \u0441\u0432\u043E\u0438 \u0441\u043B\u043E\u0432\u0430.
    \u0417\u0430 \u0441\u0432\u043E\u044E \u0441\u0435\u043C\u044C\u044E. \u0418
    \u0437\u0430 \u0441\u0432\u043E\u0438 \u0434\u043E\u043B\u0433\u0438."
  transition: 1
  transitionDuration: 0.5
  displayDuration: 11
