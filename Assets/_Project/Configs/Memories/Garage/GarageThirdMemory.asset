  image: {fileID: 2800000, guid: 0faf089b809677f41818f9b16532b31d, type: 3}
  text: "\u0422\u043E\u0442, \u043A\u0442\u043E \u043F\u043E\u0434\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u0435\u0442
