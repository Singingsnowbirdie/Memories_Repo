  image: {fileID: 2800000, guid: 0dcd5f489d554a95ae5667c667b65686, type: 3}
  text: "\u0418\u0445 \u0442\u0440\u0435\u043D\u0435\u0440 \u0433\u043E\u0432\u043E\u0440\u0438\u0442,
    \u0447\u0442\u043E \u0414\u0436\u0430\u0439\u043B\u0441 \u0432\u043B\u0435\u043F\u0438\u043B\u0441\u044F
    \u043B\u0438\u0446\u043E\u043C \u0442\u0435\u0431\u0435 \u0432 \u0448\u043B\u0435\u043C.
    \u0428\u043B\u0435\u043C \u043A\u0440\u0435\u043F\u0447\u0435. \u041F\u043E\u0445\u043E\u0436\u0435,
    \u0443 \u0414\u0436\u0430\u0439\u043B\u0441\u0430 \u0441\u043E\u0442\u0440\u044F\u0441\u0435\u043D\u0438\u0435
    \u043C\u043E\u0437\u0433\u0430."
  transition: 1
  transitionDuration: 0.5
  displayDuration: 10
