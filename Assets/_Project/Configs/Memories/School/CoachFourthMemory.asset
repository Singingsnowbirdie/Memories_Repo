  image: {fileID: 2800000, guid: 105aeb7fa3004256ac0bb421beddc465, type: 3}
  text: "\u0410 \u0442\u0435\u0431\u0435, \u043E\u043D, \u0432\u044B\u0431\u0438\u043B
    \u043A\u043E\u043B\u0435\u043D\u043E. \u041F\u043E\u044D\u0442\u043E\u043C\u0443
