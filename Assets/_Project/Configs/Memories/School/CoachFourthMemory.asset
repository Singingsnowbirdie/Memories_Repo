  image: {fileID: 2800000, guid: 63d1e7e26b244af99ef3fa9aad148b9f, type: 3}
  text: "\u042F \u0441\u043B\u0438\u0448\u043A\u043E\u043C \u0441\u043E\u0441\u0440\u0435\u0434\u043E\u0442\u043E\u0447\u0438\u043B\u0441\u044F
    \u043D\u0430 \u043C\u044F\u0447\u0435. \u0412\u0438\u0434\u0438\u043C\u043E,
    \u043E\u043D \u0442\u043E\u0436\u0435. \u0413\u043B\u0443\u043F\u043E \u0432\u044B\u0448\u043B\u043E.
    \u041D\u043E \u043D\u0435 \u043C\u043E\u044F \u0432\u0438\u043D\u0430 \u0438
    \u043D\u0435 \u0435\u0433\u043E. \u0427\u0442\u043E \u0441 \u043D\u0438\u043C?"
  transition: 1
  transitionDuration: 0.5
  displayDuration: 10
