  image: {fileID: 2800000, guid: a7fc304473be43bda087c5c03ed06d60, type: 3}
  text: "\u041D\u0435 \u0434\u0435\u0440\u0433\u0430\u0439\u0441\u044F. \u0421\u0435\u0439\u0447\u0430\u0441
    \u0432\u044B\u0437\u043E\u0432\u0443\u0442 \u0441\u043A\u043E\u0440\u0443\u044E,
    \u0438 \u043F\u043E\u0435\u0434\u0435\u0448\u044C \u0432 \u0431\u043E\u043B\u044C\u043D\u0438\u0446\u0443.
    \u0421\u0442\u043E\u0438\u043B\u043E \u043C\u043D\u0435 \u043E\u0442\u043E\u0439\u0442\u0438
    \u043D\u0430 \u0442\u0440\u0438 \u043C\u0438\u043D\u0443\u0442\u044B... \u041A\u0430\u043A\u043E\u0433\u043E
    \u0447\u0435\u0440\u0442\u0430 \u0432\u044B \u0441\u0442\u043E\u043B\u043A\u043D\u0443\u043B\u0438\u0441\u044C?"
  transition: 1
  transitionDuration: 0.5
  displayDuration: 12
