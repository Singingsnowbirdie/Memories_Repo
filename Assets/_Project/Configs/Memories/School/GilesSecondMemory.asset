  image: {fileID: 2800000, guid: 959605b6c14dd284e836ff83b7820de7, type: 3}
  text: "\u041F\u043E\u0445\u043E\u0436\u0435, \u043E\u043D \u0432\u043E\u043E\u0431\u0449\u0435
    \u043D\u0435 \u043C\u043E\u0436\u0435\u0442 \u043F\u0435\u0440\u0435\u043D\u043E\u0441\u0438\u0442\u044C
    \u0432\u0435\u0441 \u043D\u0430 \u043B\u0435\u0432\u0443\u044E \u043D\u043E\u0433\u0443.
    \u0412\u043E\u0437\u043C\u043E\u0436\u043D\u043E, \u043A\u043E\u043B\u0435\u043D\u043E.
    \u0415\u0441\u043B\u0438 \u0442\u0430\u043A, - \u043E\u0447\u0435\u043D\u044C
    \u043D\u0435\u043F\u0440\u0438\u044F\u0442\u043D\u0430\u044F \u0442\u0440\u0430\u0432\u043C\u0430."
