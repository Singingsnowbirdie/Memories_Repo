  image: {fileID: 2800000, guid: a1513a69865b5ce418b560cfead87c8a, type: 3}
  text: "\u041D\u0430\u0434\u0435\u044E\u0441\u044C, \u0432\u0441\u0435 \u043E\u0431\u043E\u0439\u0434\u0435\u0442\u0441\u044F. \u041D\u043E \u0414\u0436\u0430\u0439\u043B\u0441 \u043B\u0435\u0436\u0438\u0442. \u041A\u0430\u0436\u0435\u0442\u0441\u044F \u043E\u043D \u0432\u043E\u043E\u0431\u0449\u0435 \u0431\u0435\u0437 \u0441\u043E\u0437\u043D\u0430\u043D\u0438\u044F. \u0410 \u041A\u043E\u043B\u0441\u043E\u043D... \u043E\u043D \u043F\u044B\u0442\u0430\u0435\u0442\u0441\u044F \u0432\u0441\u0442\u0430\u0442\u044C."
  transition: 1
  transitionDuration: 0.35
  displayDuration: 13
