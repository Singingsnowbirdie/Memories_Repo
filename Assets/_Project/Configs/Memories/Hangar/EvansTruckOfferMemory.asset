  image: {fileID: 2800000, guid: 91f71106640947a7bc33461f793607d1, type: 3}
  text: "\u042D\u0432\u0430\u043D\u0441: \u041D\u0438\u0436\u0435 \u0440\u044B\u043D\u043A\u0430.
    \u0418 \u0431\u0435\u0437 \u0430\u0443\u043A\u0446\u0438\u043E\u043D\u0430. \u041F\u043E
    \u0444\u0438\u043A\u0441\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u043E\u0439
    \u0446\u0435\u043D\u0435. \u0415\u0441\u043B\u0438 \u043F\u043E\u0442\u044F\u043D\u0435\u0442\u0435
    - \u0443\u0436\u0435 \u043D\u0435 \u043F\u0440\u0438\u0434\u0435\u0442\u0441\u044F
    \u0440\u0430\u0431\u043E\u0442\u0430\u0442\u044C \u043D\u0430 \u043A\u043E\u0433\u043E-\u0442\u043E.
    \u0411\u0443\u0434\u0435\u0442\u0435 \u0441\u0430\u043C\u0438 \u0441\u0435\u0431\u0435
    \u0445\u043E\u0437\u044F\u0435\u0432\u0430."
  transition: 1
  transitionDuration: 0.5
  displayDuration: 13
