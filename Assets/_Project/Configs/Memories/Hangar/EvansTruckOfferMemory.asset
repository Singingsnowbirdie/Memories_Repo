  image: {fileID: 2800000, guid: 1d9f91c85f144d35987dd86f5b198045, type: 3}
  text: "\u042D\u0432\u0430\u043D\u0441: \u0412\u044B \u043F\u0430\u0440\u043D\u0438
    \u043E\u0431\u0430 \u043C\u043E\u043B\u043E\u0434\u044B\u0435. \u0422\u0440\u0430\u043A
    \u0431\u0443\u0434\u0435\u0442 \u0441\u0430\u043C \u0437\u0430 \u0441\u0435\u0431\u044F
    \u043E\u0442\u0434\u0430\u0432\u0430\u0442\u044C \u043A\u0440\u0435\u0434\u0438\u0442.
    \u041E\u0442\u043E\u0431\u044C\u0435\u0442\u0435\u0441\u044C - \u0441\u043E\u0432\u0441\u0435\u043C
    \u043F\u043E \u0434\u0440\u0443\u0433\u043E\u043C\u0443 \u0440\u0443\u0441\u043B\u0443
    \u0436\u0438\u0437\u043D\u044C \u043D\u0430\u043F\u0440\u0430\u0432\u0438\u0442\u0435."
