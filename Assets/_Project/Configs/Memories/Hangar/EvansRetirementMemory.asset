  image: {fileID: 2800000, guid: af183e0ab04041ba9973d9e835c912b5, type: 3}
  text: "\u042D\u0432\u0430\u043D\u0441: \u041C\u0435\u043D\u044F \u0432\u0441\u0435\u0433\u0434\u0430
    \u0432\u043E\u0441\u0445\u0438\u0449\u0430\u043B\u043E, \u043A\u0430\u043A \u043E\u043D\u0438
    \u044D\u0442\u043E \u0441\u0434\u0435\u043B\u0430\u043B\u0438. \u041D\u0438 \u0441\u043A\u0430\u043D\u0434\u0430\u043B\u0430.
    \u041D\u0438 \u0431\u0430\u043D\u043A\u0440\u043E\u0442\u0441\u0442\u0432\u0430.
    \u041F\u0440\u043E\u0441\u0442\u043E \u0437\u0430\u043A\u0440\u044B\u043B\u0438
    \u0432\u0441\u0435 \u043A\u043E\u043D\u0442\u0440\u0430\u043A\u0442\u044B, \u0440\u0430\u0441\u043F\u043B\u0430\u0442\u0438\u043B\u0438\u0441\u044C
    \u0441 \u043F\u043E\u0434\u0440\u044F\u0434\u0447\u0438\u043A\u0430\u043C\u0438,
    \u0438 \u0432\u044B\u0448\u043B\u0438 \u0447\u0438\u0441\u0442\u043E. \u0421
    \u0434\u043E\u0441\u0442\u043E\u0438\u043D\u0441\u0442\u0432\u043E\u043C."
  transition: 1
  transitionDuration: 0.5
  displayDuration: 16
