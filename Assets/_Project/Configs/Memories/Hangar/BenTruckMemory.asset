  image: {fileID: 2800000, guid: fa96594e519c46b4a0b0048732f90a2e, type: 3}
  text: "\u0411\u0435\u043D: \u042D\u0432\u0430\u043D\u0441 \u0441\u043A\u0430\u0437\u0430\u043B,
