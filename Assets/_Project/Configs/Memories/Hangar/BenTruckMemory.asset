  image: {fileID: 2800000, guid: c278a07816c544dfb0422785e4cad21c, type: 3}
  text: "\u0411\u0435\u043D: \u041F\u0440\u043E\u043A\u043B\u044F\u0442\u0430\u044F
    \u0441\u0442\u0440\u043E\u0439\u043A\u0430 \u0432 \u043F\u0440\u0438\u0433\u043E\u0440\u043E\u0434\u0435:
    \u0422\u0430\u043C \u0441\u043D\u044F\u043B\u0438 \u0441\u0442\u043E\u043B\u044C\u043A\u043E
    \u0437\u0435\u043C\u043B\u0438, \u0447\u0442\u043E \u0433\u0443\u043B\u044F\u044E\u0442
    \u043F\u044B\u043B\u044C\u043D\u044B\u0435 \u0431\u0443\u0440\u0438. \u0424\u0438\u043B\u044C\u0442\u0440
    \u0437\u0430\u0431\u0438\u043B\u043E \u0442\u0430\u043A, \u0447\u0442\u043E \u0443
    \u043F\u0440\u0438\u0446\u0435\u043F\u0430 \u043D\u0430\u0447\u0430\u043B\u0438
    \u043F\u0440\u0438\u0445\u0432\u0430\u0442\u044B\u0432\u0430\u0442\u044C \u0442\u043E\u0440\u043C\u043E\u0437\u0430."
  transition: 1
  transitionDuration: 0.5
  displayDuration: 12
