  image: {fileID: 2800000, guid: 2f33029f71434476b5cd54ef21a2cbf6, type: 3}
  text: "\u0410\u043B\u0435\u043A\u0441: \u0421\u043F\u0430\u0441\u0438\u0431\u043E,
    \u043C\u0438\u0441\u0442\u0435\u0440 \u042D\u0432\u0430\u043D\u0441. \u042F \u044D\u0442\u043E
    \u043F\u0440\u0430\u0432\u0434\u0430 \u0446\u0435\u043D\u044E. \u0422\u043E\u043B\u044C\u043A\u043E
    \u043C\u043D\u0435 \u043D\u0443\u0436\u043D\u043E \u043E\u0431\u0441\u0443\u0434\u0438\u0442\u044C
    \u044D\u0442\u043E \u0441 \u0411\u0435\u043D\u043E\u043C. \u0411\u0435\u0437
    \u043D\u0435\u0433\u043E \u0442\u0430\u043A\u043E\u0435 \u0440\u0435\u0448\u0435\u043D\u0438\u0435
    \u044F \u043F\u0440\u0438\u043D\u044F\u0442\u044C \u043D\u0435 \u043C\u043E\u0433\u0443."
