  image: {fileID: 2800000, guid: 62278fa63d8366541b3443dc897fe337, type: 3}
  text: "\u0417\u043D\u0430\u0435\u0448\u044C, \u0410\u043B\u0435\u043A\u0441. \u0422\u0432\u043E\u044F
    \u0442\u0440\u0430\u0432\u043C\u0430. \u041F\u043E\u0441\u043B\u0435 \u043D\u0435\u0451
