  image: {fileID: 2800000, guid: 9ef1f8eed96a75d4e86128d6978431ac, type: 3}
  text: "\u042D\u0439! \u042F \u043B\u0435\u0436\u0430\u043B \u043D\u0430 \u043A\u043E\u0439\u043A\u0435
    \u0431\u043E\u0433 \u0437\u043D\u0430\u0435\u0442 \u0441\u043A\u043E\u043B\u044C\u043A\u043E
    \u0432\u0440\u0435\u043C\u0435\u043D\u0438. \u041C\u043D\u0435 \u0441\u043A\u0430\u0437\u0430\u043B\u0438,
    \u0447\u0442\u043E \u044F \u0431\u043E\u043B\u044C\u0448\u0435 \u043D\u0435 \u0441\u043C\u043E\u0433\u0443
    \u0438\u0433\u0440\u0430\u0442\u044C. \u0417\u043D\u0430\u0435\u0448\u044C...
    \u042D\u0442\u043E \u0441\u043B\u043E\u0436\u043D\u043E. \u041D\u043E \u044F
    \u043D\u0438\u043A\u043E\u0433\u0434\u0430 \u043D\u0435 \u0441\u0440\u044B\u0432\u0430\u043B
    \u044D\u0442\u043E \u043D\u0430 \u0442\u0435\u0431\u0435."
  transition: 2
  transitionDuration: 0.4
  displayDuration: 13
