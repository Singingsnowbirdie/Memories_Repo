  image: {fileID: 2800000, guid: d97cf01d32c4459a9ef3d8f3d0c32cd7, type: 3}
  text: "\u042F \u0442\u0435\u0440\u043F\u0435\u043B\u0430 \u0441\u043A\u043E\u043B\u044C\u043A\u043E
    \u043C\u043E\u0433\u043B\u0430! \u041D\u043E \u044F \u0442\u043E\u0436\u0435
    \u0436\u0438\u0432\u043E\u0439 \u0447\u0435\u043B\u043E\u0432\u0435\u043A! \u0418
    \u044F \u0445\u043E\u0447\u0443, \u0447\u0442\u043E\u0431\u044B \u0440\u044F\u0434\u043E\u043C
    \u0431\u044B\u043B \u043D\u0435\u0436\u043D\u044B\u0439 \u0438 \u0437\u0430\u0431\u043E\u0442\u043B\u0438\u0432\u044B\u0439
    \u043F\u0430\u0440\u0442\u043D\u0435\u0440."
  transition: 2
  transitionDuration: 0.4
  displayDuration: 8.666667
