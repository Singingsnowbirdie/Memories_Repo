  image: {fileID: 2800000, guid: 5e770d98d47a48d9a07eb492f106f0f2, type: 3}
  text: "\u041A\u043E\u0440\u043E\u0447\u0435. \u041D\u0430\u043C \u043D\u0430\u0434\u043E
    \u0432\u0437\u044F\u0442\u044C \u043F\u0430\u0443\u0437\u0443. \u0418 \u0443\u0436
    \u043F\u043E\u0442\u0440\u0443\u0434\u0438\u0441\u044C \u043D\u0435 \u0440\u0430\u0441\u0441\u043A\u0430\u0437\u044B\u0432\u0430\u0442\u044C
    \u043E\u0431\u043E \u043C\u043D\u0435 \u0432\u0441\u044F\u043A\u0438\u0435 \u0433\u0430\u0434\u043E\u0441\u0442\u0438.
    \u041D\u0435 \u0438\u0441\u043A\u0430\u0436\u0430\u0439 \u0438\u0441\u0442\u043E\u0440\u0438\u044E
    \u043D\u0430\u0448\u0438\u0445 \u043E\u0442\u043D\u043E\u0448\u0435\u043D\u0438\u0439.
    \u041E\u0441\u0442\u0430\u043D\u044C\u0441\u044F \u0434\u0436\u0435\u043D\u0442\u043B\u044C\u043C\u0435\u043D\u043E\u043C
    \u0445\u043E\u0442\u044F \u0431\u044B \u0432 \u044D\u0442\u043E\u043C."
  transition: 2
  transitionDuration: 0.4
  displayDuration: 13.166667
