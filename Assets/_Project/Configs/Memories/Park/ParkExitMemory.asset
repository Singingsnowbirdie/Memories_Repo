  image: {fileID: 2800000, guid: 4a37e327135e4621b76b2f474bac9958, type: 3}
  text: "\u041D\u0435 \u0441\u043C\u0435\u0439 \u043F\u0435\u0440\u0435\u043A\u043B\u0430\u0434\u044B\u0432\u0430\u0442\u044C
    \u044D\u0442\u043E \u043D\u0430 \u043C\u0435\u043D\u044F! \u0422\u044B \u0441\u0442\u0430\u043B
    \u043E\u0437\u043B\u043E\u0431\u043B\u0435\u043D\u043D\u044B\u043C! \u0412\u0435\u0434\u0435\u0448\u044C
    \u0441\u0435\u0431\u044F \u043A\u0430\u043A \u043D\u0435\u0443\u0434\u0430\u0447\u043D\u0438\u043A!"
  transition: 2
  transitionDuration: 0.4
  displayDuration: 6.8333335
