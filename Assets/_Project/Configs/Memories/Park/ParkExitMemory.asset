  image: {fileID: 2800000, guid: 19c4e47ed0c841f0983882c95aab65da, type: 3}
  text: "\u0412\u043E\u0442 \u0432\u0438\u0434\u0438\u0448\u044C! \u0418\u0437 \u0442\u0435\u0431\u044F
    \u043F\u0440\u044F\u043C\u043E \u0431\u0440\u044B\u0437\u0436\u0435\u0442 \u0433\u0440\u044F\u0437\u044C!
    \u0422\u044B \u0442\u0435\u043F\u0435\u0440\u044C \u0441\u043C\u043E\u0442\u0440\u0438\u0448\u044C
    \u043D\u0430 \u0432\u0441\u0435, \u043A\u0430\u043A \u0447\u0435\u0440\u0435\u0437
    \u0433\u0440\u044F\u0437\u043D\u043E\u0435 \u0441\u0442\u0435\u043A\u043B\u043E.
    \u041E\u0431 \u044D\u0442\u043E\u043C \u044F \u0438 \u0433\u043E\u0432\u043E\u0440\u0438\u043B\u0430
    \u0441 \u0441\u0430\u043C\u043E\u0433\u043E \u043D\u0430\u0447\u0430\u043B\u0430."
  transition: 2
  transitionDuration: 0.4
  displayDuration: 10.916667
