  image: {fileID: 2800000, guid: db0570d80604431cacb9d69e7222edf7, type: 3}
  text: "\u0421 \u043F\u0435\u0440\u0441\u043F\u0435\u043A\u0442\u0438\u0432\u0430\u043C\u0438.
    \u0410 \u043D\u0435 \u0441\u043E \u0441\u043B\u043E\u043C\u0430\u043D\u043D\u043E\u0439
    \u0441\u043F\u043E\u0440\u0442\u0438\u0432\u043D\u043E\u0439 \u043A\u0430\u0440\u044C\u0435\u0440\u043E\u0439."
  transition: 2
  transitionDuration: 0.4
  displayDuration: 5
